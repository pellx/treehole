+import express from 'express';
+import type { Request, Response, NextFunction } from 'express';
+import multer from 'multer';
+import request from 'supertest';
+import { avatarUploadOptions } from './avatar-upload.options';
+
+describe('avatar multipart limits', () => {
+  function app(options = avatarUploadOptions) {
+    const server = express();
+    server.post('/avatar', multer(options).single('file'), (req, res) => {
+      res.json({ bytes: req.file?.buffer.length });
+    });
+    server.use((error: any, _req: Request, res: Response, _next: NextFunction) => {
+      res.status(400).json({ code: error.code });
+    });
+    return server;
+  }
+  it('reproduces the old parts: 1 failure for one valid file', async () => {
+    const result = await request(app({
+      ...avatarUploadOptions, limits: { ...avatarUploadOptions.limits, parts: 1 },
+    })).post('/avatar').attach('file', Buffer.from('jpeg'), 'avatar.jpg');
+    expect(result.body.code).toBe('LIMIT_PART_COUNT');
+  });
+  it('accepts a single file with the current options', async () => {
+    const result = await request(app()).post('/avatar').attach('file', Buffer.from('jpeg'), 'avatar.jpg');
+    expect(result.status).toBe(200);
+    expect(result.body.bytes).toBe(4);
+  });
+  it('rejects a second file', async () => {
+    const result = await request(app()).post('/avatar')
+      .attach('file', Buffer.from('a'), 'a.jpg').attach('file', Buffer.from('b'), 'b.jpg');
+    expect(result.body.code).toBe('LIMIT_FILE_COUNT');
+  });
+  it('rejects additional form fields', async () => {
+    const result = await request(app()).post('/avatar').field('extra', 'x')
+      .attach('file', Buffer.from('jpeg'), 'avatar.jpg');
+    expect(result.body.code).toBe('LIMIT_FIELD_COUNT');
+  });
+  it('rejects files larger than 5MB', async () => {
+    const result = await request(app()).post('/avatar')
+      .attach('file', Buffer.alloc(5 * 1024 * 1024 + 1), 'avatar.jpg');
+    expect(result.body.code).toBe('LIMIT_FILE_SIZE');
+  });
+});
