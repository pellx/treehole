@@ -0,0 +1,87 @@
+import { BadRequestException, HttpException, HttpStatus, Injectable, Logger, ServiceUnavailableException, UnauthorizedException } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import { InjectRepository } from '@nestjs/typeorm';
+import { randomUUID } from 'node:crypto';
+import { mkdir, rename, rm, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { Repository } from 'typeorm';
+import { ModerationService } from '../moderation/moderation.service';
+import { RedisService } from '../redis/redis.service';
+import { UserEntity } from './entities/user.entity';
+import { AvatarImageProcessor } from './avatar-image.processor';
+
+@Injectable()
+export class UserAvatarService {
+  private readonly logger = new Logger(UserAvatarService.name);
+  private readonly storageDir: string;
+  private readonly reviewDir: string;
+  private readonly publicBase: string;
+
+  constructor(
+    @InjectRepository(UserEntity) private readonly users: Repository<UserEntity>,
+    private readonly moderation: ModerationService,
+    private readonly processor: AvatarImageProcessor,
+    private readonly redis: RedisService,
+    config: ConfigService,
+  ) {
+    this.storageDir = config.get<string>('AVATAR_STORAGE_DIR') || '/var/www/img/user-icon';
+    this.reviewDir = config.get<string>('AVATAR_REVIEW_DIR') || '/var/www/img/pre-upload/avatar-review';
+    this.publicBase = (config.get<string>('IMG_BASE_URL') || 'https://www.leisure.xin:33433').replace(/\/$/, '');
+  }
+
+  getUrl(filename: string | null | undefined): string | null {
+    return filename && /^[0-9a-f-]{36}\.(?:jpg|webp)$/.test(filename)
+      ? this.publicBase + '/user-icon/' + filename : null;
+  }
+
+  private async remove(path: string) {
+    await rm(path, { force: true }).catch((error) => {
+      this.logger.warn('Avatar file cleanup failed: ' + error.message);
+    });
+  }
+
+  async upload(userId: number, file: Express.Multer.File | undefined) {
+    if (!file?.buffer?.length) throw new BadRequestException('请选择头像图片');
+    if (file.buffer.length > 5 * 1024 * 1024) throw new BadRequestException('头像不能超过 5MB');
+    const allowed = await this.redis.client.set('avatar:upload:' + userId, '1', 'EX', 10, 'NX');
+    if (!allowed) throw new HttpException('头像上传过于频繁，请稍后重试', HttpStatus.TOO_MANY_REQUESTS);
+
+    await this.processor.validate(file.buffer);
+    const filename = randomUUID() + '.jpg';
+    const reviewPath = join(this.reviewDir, filename);
+    const finalPath = join(this.storageDir, filename);
+    let published = false;
+    let moved = false;
+    try {
+      await mkdir(this.reviewDir, { recursive: true });
+      await mkdir(this.storageDir, { recursive: true });
+      // Aliyun's existing URL review needs a short-lived, unlinked review file.
+      await writeFile(reviewPath, file.buffer, { flag: 'wx', mode: 0o644 });
+      let timeout: ReturnType<typeof setTimeout> | undefined;
+      const result = await Promise.race([
+        this.moderation.moderateImage(reviewPath, true),
+        new Promise<never>((_, reject) => {
+          timeout = setTimeout(() => reject(new ServiceUnavailableException('头像审核超时，请稍后重试')), 45000);
+        }),
+      ]).finally(() => clearTimeout(timeout));
+      if (!result.passed) throw new BadRequestException(result.reason || '头像审核未通过');
+      await rename(reviewPath, finalPath);
+      moved = true;
+      const previous = await this.users.manager.transaction(async (manager) => {
+        const repository = manager.getRepository(UserEntity);
+        const user = await repository.findOne({
+          where: { user_id: userId }, lock: { mode: 'pessimistic_write' },
+        });
+        if (!user) throw new UnauthorizedException('USER_NOT_FOUND');
+        await repository.update({ user_id: userId }, { avatar_filename: filename });
+        return user.avatar_filename;
+      });
+      published = true;
+      if (previous && this.getUrl(previous)) await this.remove(join(this.storageDir, previous));
+      return { avatar_url: this.getUrl(filename) };
+    } finally {
+      await this.remove(reviewPath);
+      if (moved && !published) await this.remove(finalPath);
+    }
+  }
+}
