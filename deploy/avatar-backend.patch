+import { BadRequestException, Injectable, ServiceUnavailableException } from '@nestjs/common';
+import { execFile } from 'node:child_process';
+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { promisify } from 'node:util';
+
+const execute = promisify(execFile);
+
+@Injectable()
+export class AvatarImageProcessor {
+  // Validate the client-produced image without changing its bytes.
+  async validate(buffer: Buffer): Promise<void> {
+    if (buffer[0] !== 255 || buffer[1] !== 216 || buffer[2] !== 255) {
+      throw new BadRequestException('头像必须为裁剪后的 512×512 JPEG 图片');
+    }
+    const directory = await mkdtemp(join(tmpdir(), 'treehole-avatar-'));
+    try {
+      const source = join(directory, 'avatar.jpg');
+      await writeFile(source, buffer, { mode: 0o600 });
+      const dimensions = await Promise.all(['width', 'height'].map(async (field) => {
+        const { stdout } = await execute('vipsheader', ['-f', field, source], { timeout: 10000 });
+        return Number(stdout.trim());
+      }));
+      if (dimensions[0] !== 512 || dimensions[1] !== 512) {
+        throw new BadRequestException('头像尺寸必须为 512×512，请在客户端重新裁剪');
+      }
+      // Force full decoding and reject corrupt/truncated JPEGs; no output file.
+      await execute('vips', ['avg', source + '[fail-on=warning]'], {
+        timeout: 15000, maxBuffer: 1024 * 1024,
+      });
+    } catch (error) {
+      if (error instanceof BadRequestException) throw error;
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
+        throw new ServiceUnavailableException('头像校验服务暂时不可用');
+      }
+      throw new BadRequestException('头像文件无效，请在客户端重新裁剪');
+    } finally {
+      await rm(directory, { recursive: true, force: true });
+    }
+  }
+}
