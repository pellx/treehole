+    (service as any).client = {
+      imageModeration: jest.fn(async () => ({ body: { code: 200, data: { result } } })),
+    };
+    return service;
+  }
+
+  it('accepts the documented nonLabel response without confidence', async () => {
+    await expect(moderation([{ label: 'nonLabel' }]).moderateImage('/var/www/img/test.jpg', true))
+      .resolves.toMatchObject({ passed: true });
+  });
+
+  it('rejects a risk label without confidence', async () => {
