+const fs = require('node:fs/promises');
+const path = require('node:path');
+const mysql = require('mysql2/promise');
+
+async function main() {
+  for (const key of ['DB_HOST', 'DB_USERNAME', 'DB_NAME']) {
+    if (!process.env[key]) throw new Error('Missing environment variable: ' + key);
+  }
+  const connection = await mysql.createConnection({
+    host: process.env.DB_HOST, port: Number(process.env.DB_PORT) || 3306,
+    user: process.env.DB_USERNAME, password: process.env.DB_PASSWORD,
+    database: process.env.DB_NAME,
+  });
+  try {
+    const [columns] = await connection.query(
+      "SELECT DATA_TYPE, CHARACTER_MAXIMUM_LENGTH, IS_NULLABLE FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = 'users' AND column_name = 'avatar_filename'",
+    );
+    if (columns.length) {
+      const column = columns[0];
+      if (column.DATA_TYPE !== 'varchar' || Number(column.CHARACTER_MAXIMUM_LENGTH) < 64 || column.IS_NULLABLE !== 'YES') {
+        throw new Error('Existing avatar_filename schema differs; inspect it before continuing.');
+      }
+      console.log('Avatar column already exists; skipped.');
+      return;
+    }
+    await connection.query(await fs.readFile(path.join(__dirname, '..', 'database', 'migrations', '20260927_add_user_avatar.sql'), 'utf8'));
+    console.log('Avatar migration applied.');
+  } finally {
+    await connection.end();
+  }
+}
+main().catch((error) => { console.error('Avatar migration failed:', error.message); process.exitCode = 1; });
