+import { BadRequestException } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import { mkdtemp, mkdir, readFile, readdir, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { ModerationService } from '../moderation/moderation.service';
+import { UserAvatarService } from './user-avatar.service';
+
+describe('approved avatar publication', () => {
+  let root: string;
+  let service: UserAvatarService;
+  let current: string | null;
+  let update: jest.Mock;
+  let moderateImage: jest.Mock;
+  let validate: jest.Mock;
+  let transaction: jest.Mock;
+  const previous = '11111111-1111-4111-8111-111111111111.webp';
+  const file = { buffer: Buffer.from('upload') } as Express.Multer.File;
+
+  beforeEach(async () => {
+    root = await mkdtemp(join(tmpdir(), 'avatar-test-'));
+    await mkdir(join(root, 'icons'));
+    current = previous;
+    await writeFile(join(root, 'icons', previous), 'previous approved image');
+    update = jest.fn(async (_where, value) => { current = value.avatar_filename; });
+    const repository = { findOne: jest.fn(async () => ({ avatar_filename: current })), update };
+    transaction = jest.fn(async (fn) => fn({ getRepository: () => repository }));
+    moderateImage = jest.fn(async () => ({ passed: true }));
+    validate = jest.fn(async () => undefined);
+    service = new UserAvatarService(
+      { manager: { transaction } } as any,
+      { moderateImage } as any, { validate } as any,
+      { client: { set: jest.fn(async () => 'OK') } } as any,
+      new ConfigService({ AVATAR_STORAGE_DIR: join(root, 'icons'), AVATAR_REVIEW_DIR: join(root, 'review') }),
+    );
+  });
+  afterEach(async () => { await rm(root, { recursive: true, force: true }); });
+
+  it('reviews uploaded bytes before publishing and removes the old approved image', async () => {
+    moderateImage.mockImplementation(async (path, required) => {
+      expect(required).toBe(true);
+      expect(await readFile(path, 'utf8')).toBe('upload');
+      expect(await readdir(join(root, 'icons'))).toEqual([previous]);
+      expect(update).not.toHaveBeenCalled();
+      return { passed: true };
+    });
+    const result = await service.upload(7, file);
+    expect(result.avatar_url).toBe('https://www.leisure.xin:33433/user-icon/' + current);
+    expect(await readdir(join(root, 'icons'))).toEqual([current]);
+    expect(await readdir(join(root, 'review'))).toEqual([]);
+  });
+
+  it('keeps the current avatar and deletes review files when moderation rejects', async () => {
+    moderateImage.mockResolvedValue({ passed: false, reason: '图片审核未通过' });
+    await expect(service.upload(7, file)).rejects.toThrow('图片审核未通过');
+    expect(update).not.toHaveBeenCalled();
+    expect(await readdir(join(root, 'icons'))).toEqual([previous]);
+    expect(await readdir(join(root, 'review'))).toEqual([]);
+  });
+
+  it('does not publish when moderation is unavailable', async () => {
+    moderateImage.mockRejectedValue(new Error('upstream unavailable'));
+    await expect(service.upload(7, file)).rejects.toThrow();
+    expect(update).not.toHaveBeenCalled();
+    expect(await readdir(join(root, 'icons'))).toEqual([previous]);
+    expect(await readdir(join(root, 'review'))).toEqual([]);
+  });
+
+  it('removes the newly approved file if the database transaction fails', async () => {
+    transaction.mockRejectedValue(new Error('database unavailable'));
+    await expect(service.upload(7, file)).rejects.toThrow('database unavailable');
+    expect(await readdir(join(root, 'icons'))).toEqual([previous]);
+    expect(await readdir(join(root, 'review'))).toEqual([]);
+  });
+
+  it('rejects missing and oversized files before validation', async () => {
+    await expect(service.upload(7, undefined)).rejects.toBeInstanceOf(BadRequestException);
+    await expect(service.upload(7, { buffer: Buffer.alloc(5 * 1024 * 1024 + 1) } as Express.Multer.File))
+      .rejects.toBeInstanceOf(BadRequestException);
+    expect(validate).not.toHaveBeenCalled();
+  });
+
+  it('strict image moderation fails closed when the provider is disabled', async () => {
+    const moderation = new ModerationService(new ConfigService({ MODERATION_ENABLED: 'false' }));
+    await expect(moderation.moderateImage('unused', true))
+      .resolves.toMatchObject({ passed: false });
+  });
+
+  it('strict image moderation rejects a malformed success response', async () => {
+    const moderation = new ModerationService(new ConfigService({ MODERATION_ENABLED: 'false' }));
+    (moderation as any).enabled = true;
+    (moderation as any).client = { imageModeration: jest.fn(async () => ({ body: { code: 200, data: {} } })) };
+    await expect(moderation.moderateImage('/var/www/img/pre-upload/avatar-review/x.webp', true))
+      .resolves.toMatchObject({ passed: false });
+  });
+});
