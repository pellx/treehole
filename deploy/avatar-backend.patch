+import { BadRequestException } from '@nestjs/common';
+import { AvatarImageProcessor } from './avatar-image.processor';
+import { execFile } from 'node:child_process';
+
+jest.mock('node:child_process', () => ({ execFile: jest.fn() }));
+
+describe('avatar image validation', () => {
+  const jpeg = Buffer.from([255, 216, 255, 0]);
+  beforeEach(() => {
+    (execFile as unknown as jest.Mock).mockImplementation((_file, args, _options, callback) => {
+      callback(null, { stdout: args[0] === '-f' ? '512\n' : '100\n' });
+    });
+  });
+
+  it('rejects other formats without launching the decoder', async () => {
+    (execFile as unknown as jest.Mock).mockClear();
+    await expect(new AvatarImageProcessor().validate(Buffer.from('not jpeg')))
+      .rejects.toBeInstanceOf(BadRequestException);
+    expect(execFile).not.toHaveBeenCalled();
+  });
+
+  it('validates a JPEG without replacing its bytes', async () => {
+    const before = Buffer.from(jpeg);
+    await expect(new AvatarImageProcessor().validate(jpeg)).resolves.toBeUndefined();
+    expect(jpeg).toEqual(before);
+    expect(execFile).toHaveBeenCalledWith('vips',
+      expect.arrayContaining(['avg', expect.stringContaining('[fail-on=warning]')]),
+      expect.anything(), expect.any(Function));
+  });
+
+  it('rejects a nonstandard size', async () => {
+    (execFile as unknown as jest.Mock).mockImplementation((_file, _args, _options, callback) => {
+      callback(null, { stdout: '256\n' });
+    });
+    await expect(new AvatarImageProcessor().validate(jpeg))
+      .rejects.toThrow('512×512');
+  });
+
+  it('rejects a JPEG that fails full decoding', async () => {
+    (execFile as unknown as jest.Mock).mockImplementation((_file, args, _options, callback) => {
+      callback(args[0] === 'avg' ? new Error('corrupt jpeg') : null, { stdout: '512\n' });
+    });
+    await expect(new AvatarImageProcessor().validate(jpeg)).rejects.toThrow('头像文件无效');
+  });
+});
