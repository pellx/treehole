diff --git a/VIDEO_DEPLOY.md b/VIDEO_DEPLOY.md
new file mode 100644
index 0000000..fc4ec19
--- /dev/null
+++ b/VIDEO_DEPLOY.md
@@ -0,0 +1,33 @@
+# Video module deployment
+
+Apply the migration and environment configuration before starting the updated service.
+
+## Prerequisites
+
+- MySQL migration: run `database/migrations/20260923_create_videos.sql` once against the configured database.
+- Redis and `ffmpeg` / `ffprobe` must be available to the NestJS process.
+- Configure `VIDEO_ADMIN_TOKEN` to a random value of at least 32 characters. Keep it out of Git.
+- The defaults are `VIDEO_MEDIA_ROOT=/var/www/img` and `VIDEO_PUBLIC_BASE=https://www.leisure.xin:33433`.
+- Ensure the NestJS process can write `/var/www/img/video-hls`; OpenResty must serve that directory over HTTPS. Existing MIME rules already cover `.m3u8` and `.ts`.
+
+## Register existing media
+
+Use the admin token in the `x-video-admin-token` header:
+
+```http
+POST https://tree.leisure.xin/node/videos/admin/register
+Content-Type: application/json
+x-video-admin-token: <configured token>
+
+{
+  "title": "Example video",
+  "source_path": "teacher-day.mp4",
+  "cover_path": "2.jpg"
+}
+```
+
+Paths may be relative to `VIDEO_MEDIA_ROOT` or absolute beneath it. Registration returns an ID and `pending` status. Poll `GET /node/videos/admin/:id/status` with the same header; a failed job can be resubmitted with `POST /node/videos/admin/:id/retry`. Only `ready` records appear in the public list.
+
+Public endpoints are `GET /node/videos`, `GET /node/videos/:id`, and `GET /node/videos/:id/danmaku?from_ms=0&to_ms=60000`. Posting a danmaku uses `POST /node/videos/:id/danmaku` with `x-session-id` and `x-session-secret` headers and a JSON body containing `time_ms` and `text`.
+
+Start with a short existing file to verify HLS playback and media permissions before registering the multi-gigabyte movie. The worker processes one video at a time and publishes the output only after both HLS renditions complete.
diff --git a/database/migrations/20260923_create_videos.sql b/database/migrations/20260923_create_videos.sql
new file mode 100644
index 0000000..6cfe8e2
--- /dev/null
+++ b/database/migrations/20260923_create_videos.sql
@@ -0,0 +1,24 @@
+CREATE TABLE videos (
+  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
+  title VARCHAR(200) NOT NULL,
+  source_path VARCHAR(500) NOT NULL,
+  cover_path VARCHAR(500) NOT NULL,
+  status VARCHAR(20) NOT NULL DEFAULT 'pending',
+  duration_ms INT NULL,
+  error_message VARCHAR(500) NULL,
+  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+  INDEX idx_videos_status_created (status, created_at)
+);
+
+CREATE TABLE video_danmaku (
+  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
+  video_id INT NOT NULL,
+  user_id INT NOT NULL,
+  time_ms INT NOT NULL,
+  text VARCHAR(100) NOT NULL,
+  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  INDEX idx_video_danmaku_time (video_id, time_ms),
+  CONSTRAINT fk_video_danmaku_video FOREIGN KEY (video_id) REFERENCES videos(id) ON DELETE CASCADE,
+  CONSTRAINT fk_video_danmaku_user FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
+);
