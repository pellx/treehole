+import { Module } from '@nestjs/common';
+import { BullModule } from '@nestjs/bullmq';
+import { TypeOrmModule } from '@nestjs/typeorm';
+import { UserModule } from '../user/user.module';
+import { RedisModule } from '../redis/redis.module';
+import { VideoEntity } from './entities/video.entity';
+import { DanmakuEntity } from './entities/danmaku.entity';
+import { VideosController } from './videos.controller';
+import { VideosService } from './videos.service';
+import { VideoTranscodeWorker } from './video-transcode.worker';
+import { VideoAdminGuard } from './video-admin.guard';
+
+@Module({
+  imports: [
+    TypeOrmModule.forFeature([VideoEntity, DanmakuEntity]),
+    UserModule,
+    RedisModule,
+    BullModule.forRoot({
+      connection: {
+        host: process.env.REDIS_HOST || '127.0.0.1',
+        port: Number(process.env.REDIS_PORT) || 6379,
+        password: process.env.REDIS_PASSWORD || undefined,
+      },
+    }),
+    BullModule.registerQueue({ name: 'video-transcode' }),
+  ],
+  controllers: [VideosController],
+  providers: [VideosService, VideoTranscodeWorker, VideoAdminGuard],
+})
+export class VideosModule {}
diff --git a/src/videos/videos.service.ts b/src/videos/videos.service.ts
new file mode 100644
index 0000000..242cd61
--- /dev/null
+++ b/src/videos/videos.service.ts
@@ -0,0 +1,150 @@
+import { BadRequestException, HttpException, HttpStatus, Injectable, NotFoundException } from '@nestjs/common';
+import { InjectQueue } from '@nestjs/bullmq';
+import { InjectRepository } from '@nestjs/typeorm';
+import { Queue } from 'bullmq';
+import { realpath, stat } from 'node:fs/promises';
+import { resolve, relative, sep } from 'node:path';
+import { Repository } from 'typeorm';
+import { RedisService } from '../redis/redis.service';
+import { CreateVideoDto } from './dto/create-video.dto';
+import { CreateDanmakuDto } from './dto/create-danmaku.dto';
+import { VideoEntity } from './entities/video.entity';
+import { DanmakuEntity } from './entities/danmaku.entity';
+
+@Injectable()
+export class VideosService {
+  private readonly mediaRoot = resolve(process.env.VIDEO_MEDIA_ROOT || '/var/www/img');
+  private readonly publicBase = (process.env.VIDEO_PUBLIC_BASE || 'https://www.leisure.xin:33433').replace(/\/$/, '');
+
+  constructor(
+    @InjectRepository(VideoEntity) private readonly videos: Repository<VideoEntity>,
+    @InjectRepository(DanmakuEntity) private readonly comments: Repository<DanmakuEntity>,
+    @InjectQueue('video-transcode') private readonly queue: Queue,
+    private readonly redis: RedisService,
+  ) {}
+
+  private asset(relativePath: string): string {
+    return this.publicBase + '/' + relativePath.split('/').map(encodeURIComponent).join('/');
+  }
+
+  private output(video: VideoEntity) {
+    const variants = video.duration_ms == null ? [] : [
+      { label: '360p', url: this.asset('video-hls/' + video.id + '/360p/playlist.m3u8') },
+      { label: '720p', url: this.asset('video-hls/' + video.id + '/720p/playlist.m3u8') },
+    ];
+    return {
+      id: video.id,
+      title: video.title,
+      cover_url: this.asset(video.cover_path),
+      duration_ms: video.duration_ms,
+      playback_url: this.asset('video-hls/' + video.id + '/master.m3u8'),
+      qualities: variants,
+    };
+  }
+
+  async list() {
+    const rows = await this.videos.find({
+      where: { status: 'ready' },
+      order: { created_at: 'DESC' },
+      take: 100,
+    });
+    return rows.map((row) => this.output(row));
+  }
+
+  async detail(id: number) {
+    const row = await this.ready(id);
+    return this.output(row);
+  }
+
+  private async ready(id: number) {
+    const row = await this.videos.findOneBy({ id, status: 'ready' });
+    if (!row) throw new NotFoundException('VIDEO_NOT_FOUND');
+    return row;
+  }
+
+  private async checkedFile(input: string): Promise<string> {
+    const root = await realpath(this.mediaRoot);
+    const candidate = input.startsWith(root + sep) ? input : resolve(root, input.replace(/^\//, ''));
+    const absolute = await realpath(candidate).catch(() => {
+      throw new BadRequestException('MEDIA_FILE_NOT_FOUND');
+    });
+    const path = relative(root, absolute);
+    if (!path || path.startsWith('..' + sep) || path === '..' || resolve(root, path) !== absolute) {
+      throw new BadRequestException('MEDIA_PATH_OUTSIDE_ROOT');
+    }
+    if (!(await stat(absolute)).isFile()) throw new BadRequestException('MEDIA_NOT_FILE');
+    return path.split(sep).join('/');
+  }
+
+  async register(dto: CreateVideoDto) {
+    const source = await this.checkedFile(dto.source_path);
+    const cover = await this.checkedFile(dto.cover_path);
+    const video = await this.videos.save(this.videos.create({
+      title: dto.title.trim(),
+      source_path: source,
+      cover_path: cover,
+      status: 'pending',
+    }));
+    await this.queue.add('transcode', { videoId: video.id }, {
+      jobId: 'video-' + video.id,
+      attempts: 2,
+      backoff: { type: 'exponential', delay: 5000 },
+      removeOnComplete: true,
+      removeOnFail: true,
+    });
+    return { id: video.id, status: video.status };
+  }
+
+  async retry(id: number) {
+    const video = await this.videos.findOneBy({ id });
+    if (!video) throw new NotFoundException('VIDEO_NOT_FOUND');
+    if (video.status !== 'failed') throw new BadRequestException('VIDEO_NOT_FAILED');
+    await this.videos.update(id, { status: 'pending', error_message: null });
+    await this.queue.add('transcode', { videoId: id }, {
+      jobId: 'video-' + id,
+      attempts: 2,
+      backoff: { type: 'exponential', delay: 5000 },
+      removeOnComplete: true,
+      removeOnFail: true,
+    });
+    return { id, status: 'pending' };
+  }
+
+  async status(id: number) {
+    const video = await this.videos.findOneBy({ id });
+    if (!video) throw new NotFoundException('VIDEO_NOT_FOUND');
+    return { id, status: video.status, error_message: video.error_message };
+  }
+
+  async danmaku(id: number, fromRaw: string, toRaw: string) {
+    await this.ready(id);
+    const from = Number(fromRaw);
+    const to = Number(toRaw);
+    if (!Number.isSafeInteger(from) || !Number.isSafeInteger(to) ||
+        from < 0 || to <= from || to - from > 60000) {
+      throw new BadRequestException('INVALID_TIME_RANGE');
+    }
+    return this.comments.createQueryBuilder('d')
+      .select(['d.id', 'd.time_ms', 'd.text'])
+      .where('d.video_id = :id AND d.time_ms >= :from AND d.time_ms < :to', { id, from, to })
+      .orderBy('d.time_ms', 'ASC').addOrderBy('d.id', 'ASC')
+      .limit(500).getMany();
+  }
+
+  async sendDanmaku(id: number, dto: CreateDanmakuDto, userId: number) {
+    const video = await this.ready(id);
+    const text = dto.text.trim();
+    if (!text) throw new BadRequestException('EMPTY_DANMAKU');
+    if (video.duration_ms != null && dto.time_ms > video.duration_ms) {
+      throw new BadRequestException('DANMAKU_TIME_OUT_OF_RANGE');
+    }
+    const key = 'video:danmaku:rate:' + userId;
+    const count = await this.redis.client.incr(key);
+    if (count === 1) await this.redis.client.expire(key, 10);
+    if (count > 3) throw new HttpException('DANMAKU_TOO_FREQUENT', HttpStatus.TOO_MANY_REQUESTS);
+    const row = await this.comments.save(this.comments.create({
+      video_id: id, user_id: userId, time_ms: dto.time_ms, text,
+    }));
+    return { id: row.id, time_ms: row.time_ms, text: row.text };
+  }
+}
diff --git a/src/videos/videos.spec.ts b/src/videos/videos.spec.ts
new file mode 100644
