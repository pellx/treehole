+++ b/src/videos/videos.spec.ts
@@ -0,0 +1,52 @@
+import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { ExecutionContext, UnauthorizedException } from '@nestjs/common';
+import { VideosService } from './videos.service';
+import { VideoAdminGuard } from './video-admin.guard';
+
+describe('video media paths and admin access', () => {
+  let directory: string;
+  let previousRoot: string | undefined;
+
+  beforeEach(async () => {
+    previousRoot = process.env.VIDEO_MEDIA_ROOT;
+    directory = await mkdtemp(join(tmpdir(), 'treehole-video-'));
+    await mkdir(join(directory, 'media'));
+    await writeFile(join(directory, 'media', 'clip.mp4'), 'video');
+    await writeFile(join(directory, 'outside.mp4'), 'outside');
+    process.env.VIDEO_MEDIA_ROOT = join(directory, 'media');
+  });
+
+  afterEach(async () => {
+    if (previousRoot === undefined) delete process.env.VIDEO_MEDIA_ROOT;
+    else process.env.VIDEO_MEDIA_ROOT = previousRoot;
+    await rm(directory, { recursive: true, force: true });
+  });
+
+  it('accepts an existing media file and rejects paths outside the media root', async () => {
+    const service = new VideosService({} as never, {} as never, {} as never, {} as never);
+    await expect((service as any).checkedFile('clip.mp4')).resolves.toBe('clip.mp4');
+    await expect((service as any).checkedFile('../outside.mp4')).rejects.toThrow(
+      'MEDIA_PATH_OUTSIDE_ROOT',
+    );
+  });
+
+  it('requires the configured admin token', () => {
+    const previousToken = process.env.VIDEO_ADMIN_TOKEN;
+    process.env.VIDEO_ADMIN_TOKEN = 'a'.repeat(40);
+    try {
+      const guard = new VideoAdminGuard();
+      const context = (token: string) => ({
+        switchToHttp: () => ({
+          getRequest: () => ({ headers: { 'x-video-admin-token': token } }),
+        }),
+      }) as unknown as ExecutionContext;
+      expect(guard.canActivate(context('a'.repeat(40)))).toBe(true);
+      expect(() => guard.canActivate(context('wrong'))).toThrow(UnauthorizedException);
+    } finally {
+      if (previousToken === undefined) delete process.env.VIDEO_ADMIN_TOKEN;
+      else process.env.VIDEO_ADMIN_TOKEN = previousToken;
+    }
+  });
+});
