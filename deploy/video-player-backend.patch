diff --git a/src/videos/video-admin.guard.ts b/src/videos/video-admin.guard.ts
new file mode 100644
index 0000000..a76cfcf
--- /dev/null
+++ b/src/videos/video-admin.guard.ts
@@ -0,0 +1,20 @@
+import { CanActivate, ExecutionContext, Injectable, ServiceUnavailableException, UnauthorizedException } from '@nestjs/common';
+import { timingSafeEqual } from 'node:crypto';
+
+@Injectable()
+export class VideoAdminGuard implements CanActivate {
+  canActivate(context: ExecutionContext): boolean {
+    const expected = process.env.VIDEO_ADMIN_TOKEN;
+    if (!expected || expected.length < 32) {
+      throw new ServiceUnavailableException('VIDEO_ADMIN_TOKEN_NOT_CONFIGURED');
+    }
+    const supplied = context.switchToHttp().getRequest().headers['x-video-admin-token'];
+    if (typeof supplied !== 'string') throw new UnauthorizedException();
+    const a = Buffer.from(supplied);
+    const b = Buffer.from(expected);
+    if (a.length !== b.length || !timingSafeEqual(a, b)) {
+      throw new UnauthorizedException();
+    }
+    return true;
+  }
+}
diff --git a/src/videos/video-transcode.worker.ts b/src/videos/video-transcode.worker.ts
new file mode 100644
index 0000000..a36faa4
--- /dev/null
+++ b/src/videos/video-transcode.worker.ts
@@ -0,0 +1,94 @@
+import { Processor, WorkerHost } from '@nestjs/bullmq';
+import { InjectRepository } from '@nestjs/typeorm';
+import { Job } from 'bullmq';
+import { spawn } from 'node:child_process';
+import { mkdir, realpath, rename, rm, writeFile } from 'node:fs/promises';
+import { relative, resolve, sep } from 'node:path';
+import { Repository } from 'typeorm';
+import { VideoEntity } from './entities/video.entity';
+
+@Processor('video-transcode', { concurrency: 1 })
+export class VideoTranscodeWorker extends WorkerHost {
+  private readonly mediaRoot = resolve(process.env.VIDEO_MEDIA_ROOT || '/var/www/img');
+
+  constructor(@InjectRepository(VideoEntity) private readonly videos: Repository<VideoEntity>) {
+    super();
+  }
+
+  private run(binary: string, args: string[]): Promise<string> {
+    return new Promise((resolveOutput, reject) => {
+      const child = spawn(binary, args, { shell: false });
+      let output = '';
+      let error = '';
+      child.stdout.on('data', (chunk: Buffer) => { output += chunk.toString(); });
+      child.stderr.on('data', (chunk: Buffer) => { error = (error + chunk.toString()).slice(-4000); });
+      child.on('error', reject);
+      child.on('close', (code) => code === 0
+        ? resolveOutput(output)
+        : reject(new Error(binary + ' exited ' + code + ': ' + error)));
+    });
+  }
+
+  async process(job: Job<{ videoId: number }>): Promise<void> {
+    const video = await this.videos.findOneBy({ id: job.data.videoId });
+    if (!video || video.status === 'ready') return;
+    const base = resolve(this.mediaRoot, 'video-hls');
+    const temporary = resolve(base, '.tmp-' + video.id);
+    const finished = resolve(base, String(video.id));
+    await this.videos.update(video.id, { status: 'processing', error_message: null });
+    await mkdir(base, { recursive: true });
+    await rm(temporary, { recursive: true, force: true });
+    try {
+      const root = await realpath(this.mediaRoot);
+      const source = await realpath(resolve(root, video.source_path));
+      const sourceRelative = relative(root, source);
+      if (!sourceRelative || sourceRelative === '..' || sourceRelative.startsWith('..' + sep)) {
+        throw new Error('MEDIA_PATH_OUTSIDE_ROOT');
+      }
+      const probe = await this.run('ffprobe', [
+        '-v', 'error', '-show_entries', 'format=duration', '-of', 'json', source,
+      ]);
+      const duration = Number(JSON.parse(probe).format?.duration);
+      if (!Number.isFinite(duration) || duration <= 0) throw new Error('Invalid video duration');
+
+      const renditions = [
+        { label: '360p', height: 360, bitrate: '800k', maxrate: '900k', buffer: '1600k', bandwidth: 1000000 },
+        { label: '720p', height: 720, bitrate: '2500k', maxrate: '2800k', buffer: '5000k', bandwidth: 3000000 },
+      ];
+      const master: string[] = ['#EXTM3U', '#EXT-X-VERSION:3'];
+      for (const rendition of renditions) {
+        const directory = resolve(temporary, rendition.label);
+        await mkdir(directory, { recursive: true });
+        await this.run('ffmpeg', [
+          '-hide_banner', '-loglevel', 'error', '-y', '-i', source,
+          '-map', '0:v:0', '-map', '0:a:0?',
+          '-vf', 'scale=-2:' + rendition.height,
+          '-c:v', 'libx264', '-preset', 'veryfast', '-pix_fmt', 'yuv420p',
+          '-force_key_frames', 'expr:gte(t,n_forced*6)', '-sc_threshold', '0',
+          '-b:v', rendition.bitrate, '-maxrate', rendition.maxrate, '-bufsize', rendition.buffer,
+          '-c:a', 'aac', '-b:a', '128k', '-ac', '2',
+          '-f', 'hls', '-hls_time', '6', '-hls_playlist_type', 'vod',
+          '-hls_flags', 'independent_segments',
+          '-hls_segment_filename', resolve(directory, 'segment_%05d.ts'),
+          resolve(directory, 'playlist.m3u8'),
+        ]);
+        master.push('#EXT-X-STREAM-INF:BANDWIDTH=' + rendition.bandwidth);
+        master.push(rendition.label + '/playlist.m3u8');
+      }
+      await writeFile(resolve(temporary, 'master.m3u8'), master.join('\n') + '\n');
+      await rename(temporary, finished);
+      await this.videos.update(video.id, {
+        status: 'ready',
+        duration_ms: Math.round(duration * 1000),
+        error_message: null,
+      });
+    } catch (error) {
+      await rm(temporary, { recursive: true, force: true });
+      const message = error instanceof Error ? error.message.slice(0, 500) : String(error).slice(0, 500);
+      if (job.attemptsMade + 1 >= (job.opts.attempts || 1)) {
+        await this.videos.update(video.id, { status: 'failed', error_message: message });
+      }
+      throw error;
+    }
+  }
+}
