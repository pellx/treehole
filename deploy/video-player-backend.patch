+++ b/src/videos/dto/create-danmaku.dto.ts
@@ -0,0 +1,12 @@
+import { IsInt, IsString, Length, Max, Min } from 'class-validator';
+
+export class CreateDanmakuDto {
+  @IsInt()
+  @Min(0)
+  @Max(86400000)
+  time_ms: number;
+
+  @IsString()
+  @Length(1, 100)
+  text: string;
