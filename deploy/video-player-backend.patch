+import { Body, Controller, Get, Param, ParseIntPipe, Post, Query, Req, UseGuards } from '@nestjs/common';
+import type { Request } from 'express';
+import { SessionGuard } from '../common/guards/session.guard';
+import { CreateVideoDto } from './dto/create-video.dto';
+import { CreateDanmakuDto } from './dto/create-danmaku.dto';
+import { VideoAdminGuard } from './video-admin.guard';
+import { VideosService } from './videos.service';
+
+@Controller('videos')
+export class VideosController {
+  constructor(private readonly videos: VideosService) {}
+
+  @Get()
+  list() {
+    return this.videos.list();
+  }
+
+  @Get(':id')
+  detail(@Param('id', ParseIntPipe) id: number) {
+    return this.videos.detail(id);
+  }
+
+  @Get(':id/danmaku')
+  danmaku(
+    @Param('id', ParseIntPipe) id: number,
+    @Query('from_ms') fromMs: string,
+    @Query('to_ms') toMs: string,
+  ) {
+    return this.videos.danmaku(id, fromMs, toMs);
+  }
+
+  @Post(':id/danmaku')
+  @UseGuards(SessionGuard)
+  sendDanmaku(
+    @Param('id', ParseIntPipe) id: number,
+    @Body() dto: CreateDanmakuDto,
+    @Req() req: Request & { user_id: number },
+  ) {
+    return this.videos.sendDanmaku(id, dto, req.user_id);
+  }
+
+  @Post('admin/register')
+  @UseGuards(VideoAdminGuard)
+  register(@Body() dto: CreateVideoDto) {
+    return this.videos.register(dto);
+  }
+
+  @Post('admin/:id/retry')
+  @UseGuards(VideoAdminGuard)
+  retry(@Param('id', ParseIntPipe) id: number) {
+    return this.videos.retry(id);
+  }
+
+  @Get('admin/:id/status')
+  @UseGuards(VideoAdminGuard)
+  status(@Param('id', ParseIntPipe) id: number) {
+    return this.videos.status(id);
+  }
+}
